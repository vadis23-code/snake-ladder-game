rules_version = '2';

// Brawlers Basketball Experience — server-side access control.
// The page is public; these rules are what actually protect the data.
//
//   admins/{uid}                 who is an admin (first admin is added in the Firebase console)
//   roster/{nameKey}             skill rating per player, admin-managed
//   days/{YYYY-MM-DD}            the shared teams for that day
//   days/{YYYY-MM-DD}/players/{nameKey}   today's sign-up list
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 30;
    }

    function validDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'addedBy', 'addedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /roster/{key} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && key.size() <= 200
        && request.resource.data.keys().hasOnly(['name', 'skill', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.skill is int
        && request.resource.data.skill >= 1
        && request.resource.data.skill <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /days/{day} {
      allow read: if signedIn();
      // Anyone may (re)generate the shared teams for the day.
      allow create, update: if signedIn()
        && validDay(day)
        && request.resource.data.keys().hasOnly(['teams', 'teamCount', 'sessionType', 'generatedAt'])
        && request.resource.data.teams is list
        && request.resource.data.teams.size() >= 2
        && request.resource.data.teams.size() <= 4
        && request.resource.data.teamCount == request.resource.data.teams.size()
        && request.resource.data.sessionType in ['Half Court', 'Full Court']
        && request.resource.data.generatedAt == request.time;
      allow delete: if isAdmin();

      match /players/{pid} {
        allow read: if signedIn();
        // Document id is the normalised name, so a second "create" for the same
        // name is an update and is refused — duplicates are blocked server-side.
        allow create: if signedIn()
          && validDay(day)
          && pid.size() <= 200
          && request.resource.data.keys().hasOnly(['name', 'uid', 'addedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.addedAt == request.time;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }
  }
}
